/android/settings.gradle                @newrelic/mobagent

# iOS packaging and native agent dependency
/ios/newrelic_mobile.podspec            @newrelic/mobagent
/ios/newrelic_mobile/Package.swift      @newrelic/mobagent

# This file
/.github/CODEOWNERS                     @newrelic/mobagent
