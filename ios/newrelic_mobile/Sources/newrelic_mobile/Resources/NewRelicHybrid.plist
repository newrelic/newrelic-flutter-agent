<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Read by the New Relic iOS agent to learn which framework hosts it, even when the app starts the agent
     natively before Flutter code runs. ApplicationFramework must match an NRMAApplicationPlatform name.
     ApplicationFrameworkVersion is kept equal to pubspec.yaml by the release workflow and
     test/ios_framework_plist_test.dart; do not edit it by hand. -->
<plist version="1.0">
<dict>
	<key>ApplicationFramework</key>
	<string>Flutter</string>
	<key>ApplicationFrameworkVersion</key>
	<string>1.3.5</string>
</dict>
</plist>
